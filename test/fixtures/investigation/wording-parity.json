    "overall": "<section aria-label=\"Investigation\" style=\"color:var(--fp-text-primary, #f8fafc);background:var(--fp-bg, #1a1b26);border:1px solid var(--fp-border, #334155);border-radius:var(--fp-radius, 8px);padding:20px;font-family:var(--fp-font-sans, Inter, system-ui, -apple-system, sans-serif);line-height:1.5;min-width:0;overflow-wrap:anywhere\"><h2 style=\"margin-block-start:0\">Needs attention</h2><p style=\"color:var(--fp-text-secondary, #94a3b8)\">Choose an item to inspect its recorded causes and effects.</p><p role=\"status\">Some evidence was not collected.</p><p role=\"status\">An input&#x27;s earlier origin is unknown.</p><p role=\"status\">Some evidence is hidden.</p><p role=\"status\">The recorded relationship is uncertain.</p><p role=\"status\">Evidence stops at an execution boundary.</p><p role=\"status\">Some recorded evidence could not be read.</p><p role=\"status\">Some evidence is unavailable.</p><p role=\"status\">The evidence search reached its time allowance.</p><p role=\"status\">The evidence search was cancelled.</p><p role=\"status\">A repeated dependency could not be resolved.</p><p role=\"status\">The evidence search reached its item allowance.</p><p role=\"status\">The evidence search reached its depth allowance.</p><p role=\"status\">The evidence search reached its relationship allowance.</p><p role=\"status\">The evidence search reached its request allowance.</p><p role=\"status\">The recorded evidence is incomplete.</p><p role=\"status\">Candidate ordering is unavailable.</p><p role=\"status\">Some evidence has not been checked.</p><p role=\"status\">No matching evidence was found.</p><p role=\"status\">More than one explanation remains possible.</p><p role=\"status\">Some evidence belongs to an earlier recording.</p><p role=\"status\">Some evidence uses an unsupported format.</p><p role=\"status\">Some evidence is unsupported.</p><p role=\"status\">Some evidence is unavailable for this view.</p><p role=\"status\">Attention coverag
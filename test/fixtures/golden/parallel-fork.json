    {
      "method": "onEdgeAdded",
      "event": {
        "from": "screen",
        "to": "obesity",
        "kind": "decision-branch",
        "label": "obesity"
      }
    },
    {
      "method": "onDeciderComplete",
      "event": {
        "decider": "screen",
        "type": "selector",
        "branchIds": [
          "diabetes",
          "hypertension",
          "obesity"
        ]
      }
    },
    {
      "method": "onStageAdded",
      "event": {
        "stageId": "summarize",
        "name": "Summarize",
        "type": "stage",
        "spec": {
          "name": "Summarize",
          "id": "summarize",
          "type": "stage",
          "description": "Converge screening results"
        }
      }
    },
    {

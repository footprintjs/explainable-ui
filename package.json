{
  "name": "footprint-explainable-ui",
  "version": "0.32.1",
  "description": "Themeable React components for visualizing FootPrint pipeline execution",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./flowchart": {
      "import": {
        "types": "./dist/flowchart.d.ts",
        "default": "./dist/flowchart.js"
      },
      "require": {
        "types": "./dist/flowchart.d.cts",
        "default": "./dist/flowchart.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "flowchart": [
        "./dist/flowchart.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "release:patch": "bash scripts/release.sh patch",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major",
    "test:coverage": "vitest run --coverage --coverage.reporter=json-summary --coverage.reporter=text-summary --coverage.reportsDirectory=coverage",
    "coverage:badge": "npm run test:coverage; node scripts/coverage-badge.mjs",
    "fixtures:regen": "node scripts/generate-golden-fixtures.mjs",
    "demo": "vite",
    "demo:build": "vite build",
    "demo:preview": "vite preview",
    "example:record": "node examples/replay-a-recording/record.mjs",
    "example:replay": "vite --config examples/replay-a-recording/vite.config.ts"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@xyflow/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dagre": "^0.7.54",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.8",
    "@xyflow/react": "^12.10.2",
    "footprintjs": "^9.0.0",
    "jsdom": "^29.0.1",
    "publint": "^0.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsup": "^8.4.0",
    "typescript": "^5.4.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/footprintjs/explainable-ui.git"
  },
  "keywords": [
    "footprint",
    "pipeline",
    "visualization",
    "debugging",
    "react",
    "time-travel",
    "explainable-ai"
  ],
  "dependencies": {
    "dagre": "^0.8.5"
  }
}

{
  "name": "footprint-explainable-ui",
  "version": "2.2.0",
  "description": "React components for inspecting FootPrint workflow execution, recorded state changes and time-travel debugging.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./flowchart": {
      "import": {
        "types": "./dist/flowchart.d.ts",
        "default": "./dist/flowchart.js"
      },
      "require": {
        "types": "./dist/flowchart.d.cts",
        "default": "./dist/flowchart.cjs"
      }
    },
    "./record": {
      "import": {
        "types": "./dist/record.d.ts",
        "default": "./dist/record.js"
      },
      "require": {
        "types": "./dist/record.d.cts",
        "default": "./dist/record.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "flowchart": [
        "./dist/flowchart.d.ts"
      ],
      "record": [
        "./dist/record.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "audit:evidence": "node scripts/dependency-audit/collect.mjs",
    "test:dependency-audit": "node --test scripts/dependency-audit/*.test.mjs",
    "typecheck:record-pilot": "node pilots/record-lens/require-node.mjs && tsc -p pilots/record-lens/tsconfig.json --noEmit",
    "test:record-pilot": "node pilots/record-lens/require-node.mjs && npm run typecheck:record-pilot && vitest run --config pilots/record-lens/vitest.config.ts && node pilots/record-lens/verify-package.mjs",
    "test": "npm run typecheck:test && vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "release:patch": "bash scripts/release.sh patch",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major",
    "test:coverage": "vitest run --coverage --coverage.reporter=json-summary --coverage.reporter=text-summary --coverage.reportsDirectory=coverage",
    "coverage:badge": "npm run test:coverage; node scripts/coverage-badge.mjs",
    "fixtures:regen": "node scripts/generate-golden-fixtures.mjs",
    "demo": "vite",
    "demo:build": "vite build",
    "demo:preview": "vite preview",
    "example:record": "node examples/replay-a-recording/record.mjs",
    "example:replay": "vite --config examples/replay-a-recording/vite.config.ts"
  },
  "peerDependencies": {
    "@xyflow/react": "^12.0.0",
    "dagre": "^0.8.5",
    "foottrace": "^2.3.1",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@xyflow/react": {
      "optional": true
    },
    "dagre": {
      "optional": true
    },
    "foottrace": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dagre": "^0.7.54",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "@xyflow/react": "^12.10.2",
    "dagre": "^0.8.5",
    "footprintjs": "14.0.0",
    "footprintjs-golden": "npm:footprintjs@9.15.1",
    "foottrace": "2.3.1",
    "jsdom": "^29.1.1",
    "publint": "^0.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "6.5.1",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "jsdom": {
      "undici": "^7.30.2"
    },
    "tsup": {
      "esbuild": "0.28.2"
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/footprintjs/explainable-ui.git"
  },
  "keywords": [
    "react",
    "footprintjs",
    "flowchart",
    "workflow",
    "visualization",
    "trace-viewer",
    "debugging",
    "time-travel",
    "execution-provenance"
  ],
  "homepage": "https://github.com/footprintjs/explainable-ui#readme",
  "bugs": {
    "url": "https://github.com/footprintjs/explainable-ui/issues"
  }
}
